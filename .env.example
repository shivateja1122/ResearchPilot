# ResearchPilot AI - Environment Configuration

# Primary LLM API Key (Google Gemini)
GEMINI_API_KEY=

# Search Retrieval API Key (Tavily Search)
TAVILY_API_KEY=

# Full-Page Content Extraction API Key (Jina Reader)
READER_API_KEY=

# Optional: OpenAI API Key
OPENAI_API_KEY=

# Optional: Custom OpenAI compatible API Base URL (for Groq, Ollama, vLLM, OpenRouter)
OPENAI_BASE_URL=

# Research Configuration Defaults
MAX_RESEARCH_ROUNDS=2
MAX_FOLLOW_UP_SEARCHES=4
SEARCH_TIMEOUT_SECONDS=10
PAGE_FETCH_TIMEOUT_SECONDS=10
